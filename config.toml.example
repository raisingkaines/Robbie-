# Robbie - Sanctuary Free Realms Discord Moderation Bot Configuration
[discord]
token = "YOUR_DISCORD_BOT_TOKEN_HERE"

# Strongly recommended: Restrict all moderation and admin commands to your staff server.
# When configured, commands are registered exclusively in this guild and blocked everywhere else.
# guild_id = 123456789012345678

moderator_role_ids = [
    # 123456789012345678
]

moderator_role_names = [
    "Moderator",
    "Mod",
    "Game Master",
    "Staff"
]

admin_role_ids = [
    # 123456789012345678
]

admin_role_names = [
    "Administrator",
    "Admin",
    "Lead Developer"
]

# audit_log_channel_id = 123456789012345678

# How frequently (in seconds) the bot polls server status and updates its Discord status
presence_interval_seconds = 30

[database]
# Database provider: "sqlite" or "mysql" / "mariadb"
provider = "sqlite"

# SQLite path (used when provider = "sqlite"):
path = "../Sanctuary-upstream/src/Sanctuary.Database.Sqlite/sanctuary.db"

# MySQL / MariaDB connection URL (used when provider = "mysql" or "mariadb"):
# url = "mysql://sanctuary_user:password@127.0.0.1:3306/sanctuary"

# Connection pool sizing and timeouts
max_connections = 10
min_connections = 1
acquire_timeout_seconds = 10
idle_timeout_seconds = 600

[gateway]
api_url = "http://127.0.0.1:5000"
api_key = "sanctuary_admin_secret_key"

# HTTP client timeout and connection limits
timeout_seconds = 5
connect_timeout_seconds = 5

[warning_system]
auto_mute_threshold = 3
auto_mute_duration_minutes = 30
auto_ban_threshold_1 = 5
auto_ban_duration_hours_1 = 24
auto_ban_threshold_2 = 7
auto_ban_duration_days_2 = 7
auto_ban_threshold_permanent = 10
warning_expiration_days = 30
